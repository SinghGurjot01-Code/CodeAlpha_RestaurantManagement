{
  // Express 5 on Cloudflare Workers + D1 for CodeAlpha Task 3 (DineHub Restaurant Management).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codealpha-dinehub",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],

  // Serve ../frontend as static assets; /api/* routes fall through to the Express Worker.
  "assets": { "directory": "../frontend" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codealpha-dinehub-db",
      // Real D1 database ID (an identifier, not a secret). Local dev (--local) uses .wrangler/.
      "database_id": "0f31c380-1ba8-4e35-a6ca-c7b1c08ac3ad",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "CORS_ORIGIN": "https://ca-dinehub.vercel.app",
    "SESSION_TTL_HOURS": "168",
    "DEFAULT_TAX_PERCENT": "5"
  },

  "observability": { "enabled": true }
}
